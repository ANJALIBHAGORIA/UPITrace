# Copy to .env and fill in. Never commit the real .env.

# Vertex AI is the explicit, selected production provider (chat + embeddings).
# Auth is via Application Default Credentials (gcloud auth application-default
# login) — no API key needed or read for this path.
# IMPORTANT: Vertex's supported Gemini model IDs are NOT guaranteed to match
# Google AI Studio's. Verify with:
#   python -m src.main.backend.scripts.check_vertex_status
GOOGLE_CLOUD_PROJECT=upitrace
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_GEMINI_MODEL=
VERTEX_EMBEDDING_MODEL=

# Dev/testing only — free tier via https://aistudio.google.com/apikey, no GCP
# billing. Never auto-selected in production; pass --use-ai-studio to
# build_rag_index.py explicitly to use it there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

FIRESTORE_DATABASE=
CLOUD_STORAGE_BUCKET=

# Leave unset in production.
DEV_AUTH_BYPASS=false
